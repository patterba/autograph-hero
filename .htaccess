DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On

# Addresses from the old WordPress site, so saved links and search results still work.
RedirectMatch 301 ^/terms-conditions/?$ /terms/
RedirectMatch 301 ^/privacy-policy/?$ /privacy/
RedirectMatch 301 ^/my-account(/.*)?$ /account/
RedirectMatch 301 ^/submit-an-appearance/?$ /add/
RedirectMatch 301 ^/(type|browse)(/.*)?$ /events/

# Scrapers get 403: AI training crawlers (also asked to stay out in robots.txt), crawlers
# known to ignore robots.txt, and scraping tools. Search engines, AI search/answer bots and
# link previews are not on this list. robots.txt stays readable to everyone.
RewriteCond %{REQUEST_URI} !robots\.txt$
RewriteCond %{HTTP_USER_AGENT} (GPTBot|ClaudeBot|anthropic-ai|Claude-Web|CCBot|Applebot-Extended|Bytespider|meta-externalagent|FacebookBot|cohere-ai|cohere-training-data-crawler|Diffbot|omgili|Omgilibot|ImagesiftBot|Timpibot|AI2Bot|PanguBot|img2dataset|Scrapy|python-requests|python-urllib|aiohttp|httpx|Go-http-client|node-fetch|axios|okhttp|libwww-perl|Wget|HeadlessChrome|PhantomJS|Puppeteer|Playwright|Selenium|colly|Crawl4AI|Firecrawl) [NC]
RewriteRule ^ - [F,L]

# Pages change every hour, so the host's cache and browsers must check for a new copy
# each time. Assets are fingerprinted (?v=...), so they can be kept. The app manifest and the
# offline worker (sw.js) must also be re-checked, so installed apps pick up new versions.
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <FilesMatch "\.(html|ics|txt|webmanifest)$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
    Header set X-Endurance-Cache-Level "0"
  </FilesMatch>
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set X-Endurance-Cache-Level "0"
  </Files>
</IfModule>
